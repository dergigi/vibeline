{
  "name": "vibeline",
  "version": "0.0.3",
  "description": "Voice memo processing and analysis tool",
  "scripts": {
    "lint:markdown": "markdownlint-cli2 \"**/*.{md,mdx}\" \"!node_modules\" \"!vibenv\" \"!VoiceMemos/**\" \"!ui/node_modules/**\" \"!ui/.next/**\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.{md,mdx}\" \"!node_modules\" \"!vibenv\" \"!VoiceMemos/**\" \"!ui/node_modules/**\" \"!ui/.next/**\"",
    "ui:install": "npm --prefix ui ci",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:start": "npm --prefix ui start",
    "ui:check": "npm --prefix ui run lint:all"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-cli2-formatter-pretty": "^0.0.8"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
